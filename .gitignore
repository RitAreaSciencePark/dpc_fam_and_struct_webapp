# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.mdmc_venv/
.venv/

# Secrets -- NEVER commit 
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep

# Distribution / packaging
build/
dist/
*.egg-info/

# Django local settings
*.sqlite3

# Generated Django static output
staticfiles/

# Static files : Only notebooks/, scripts/ and profiling_reports/ are tracked
# Ignore everything inside static
static/*
# But keep these directories
!static/notebooks/
!static/scripts/
!static/profiling_reports/
!static/images/
# And keep their contents
!static/notebooks/**
!static/scripts/**
!static/profiling_reports/**
!static/images/**

# Jupyter
.ipynb_checkpoints

# IDEs
.vscode/

# Misc
.DS_Store

# Kubernetes secrets created locally -- never commit
k8s/**/*secret*.yaml
k8s/**/secret.env
k8s/**/.env
