# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.mdmc_venv/

# Secrets -- NEVER commit 
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep

# Distribution / packaging
build/
dist/
*.egg-info/

# Django local settings
*.sqlite3

# Static files : Only notebooks/, scripts/ and profiling_reports/ are tracked
# Ignore everything inside static
static/*
# But keep these directories
!static/notebooks/
!static/scripts/
!static/profiling_reports/
!images/
# And keep their contents
!static/notebooks/**
!static/scripts/**
!static/profiling_reports/**
!images/**

# Jupyter
.ipynb_checkpoints

# IDEs
.vscode/

# Misc
.DS_Store
