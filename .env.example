# .env.example
DJANGO_SECRET_KEY=generate-one-with-python-manage.py-generate-secret-key
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TRUST_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DB_NAME=dpcexplorer_db
DB_USER=dpcexplorer_admin
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432
# Admin panel write mode: False = read-only (default, recommended); True = full CRUD.
DPCEXPLORER_ADMIN_WRITABLE=False