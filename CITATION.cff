# ------------------------------------------------------------------
# IDENTIFIERS
# The software DOI is the Zenodo CONCEPT DOI (the "Cite all versions"
# DOI), 10.5281/zenodo.20575268. It always resolves to the most recent
# release.
# ------------------------------------------------------------------
identifiers:
  - type: doi
    value: "10.5281/zenodo.20575268"
    description: >-
      Zenodo concept DOI for the DPCexplorer software; always resolves
      to the latest archived release (currently v1.1.0).
  - type: doi
    value: "10.5281/zenodo.20159208"
    description: >-
      Zenodo data deposit - preprocessed CSV (used to populate the DPCexplorer PostgreSQL database), FASTA, and PDB files (static assets).

# ------------------------------------------------------------------
